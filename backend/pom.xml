<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.9</version>
        <relativePath/>
    </parent>

    <groupId>com.adou</groupId>
    <artifactId>adou-ofd-backend</artifactId>
    <version>1.0.0</version>
    <name>adou-ofd-backend</name>
    <description>阿豆OFD 本地 Java 引擎</description>
    <url>https://gitcode.com/Zzuser/adouOFD</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>Zzuser</id>
            <name>Zzuser</name>
            <url>https://gitcode.com/Zzuser</url>
        </developer>
    </developers>

    <properties>
        <java.version>25</java.version>
        <ofdrw.version>2.5.1</ofdrw.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.ofdrw</groupId>
            <artifactId>ofdrw-full</artifactId>
            <version>${ofdrw.version}</version>
            <exclusions>
                <!--
                  ofdrw-converter -> org.ujmp:ujmp-core -> org.json:json:20141113，
                  而 JSON License（json.org）不是 OSI 批准许可证，且带
                  "The Software shall be used for Good, not Evil" 条款。
                  ujmp 中只有孤立的 org.ujmp.core.util.JsonUtil 引用 org.json，
                  没有任何类引用 JsonUtil；本项目只用 Matrix / DenseDoubleMatrix2D
                  与默认稠密矩阵工厂，运行期不触达该工具类，故整条排除。
                -->
                <exclusion>
                    <groupId>org.json</groupId>
                    <artifactId>json</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- 与 ofdrw-converter 2.5.1 对齐，统一使用 PDFBox 3.0.8 -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.8</version>
        </dependency>
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>fontbox</artifactId>
            <version>3.0.8</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>adou-ofd-backend</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
