{
  "name": "adou-ofd",
  "version": "1.2.0",
  "description": "阿豆OFD — 免费、离线的 OFD / PDF 桌面阅读与处理工具",
  "main": "./out/main/index.js",
  "author": "Zzuser",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://gitcode.com/Zzuser/adouOFD.git"
  },
  "homepage": "https://gitcode.com/Zzuser/adouOFD",
  "bugs": {
    "url": "https://gitcode.com/Zzuser/adouOFD/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node ../scripts/electron-vite.mjs dev",
    "preview": "node ../scripts/electron-vite.mjs preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "build": "npm run typecheck && node ../scripts/electron-vite.mjs build",
    "package:win": "npm run build && npm run jre:build && electron-builder --win nsis --x64",
    "package:inno": "npm run build && npm run jre:build && node ../scripts/build-inno.mjs",
    "package:dir": "npm run build && npm run jre:build && electron-builder --win dir --x64",
    "smoke:ui": "node ../scripts/smoke-ui.mjs",
    "smoke:text": "node ../scripts/smoke-text.mjs",
    "backend:build": "node ../scripts/build-backend.mjs",
    "jre:build": "node ../scripts/build-jre.mjs",
    "stress:fixtures": "node ../scripts/stress-fixtures.mjs",
    "stress:backend": "node ../scripts/stress-backend.mjs",
    "stress:ui": "node ../scripts/stress-ui.mjs",
    "postinstall": "node ../scripts/install-electron.mjs",
    "dev:all": "npm run backend:build && npm run dev"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@swc/core": "1.16.20",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "highlight.js": "^11.11.1",
    "iconv-lite": "^0.7.3",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
